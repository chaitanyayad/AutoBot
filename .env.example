# Host port the postgres container publishes on. Override if a native Postgres
# install already owns 5432 (check with: Get-NetTCPConnection -LocalPort 5432).
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator
# Task queue. Use memory:// to run the broker in-process (tests, demos).
BROKER_URL=amqp://guest:guest@localhost:5672/
TASK_QUEUE=task_queue
WORKER_PREFETCH=1

DEFAULT_MAX_RETRIES=3
SQL_ECHO=false

# Compose only: host port for the API, and how long the stand-in handler sleeps
# so parallelism across workers is visible rather than instant.
API_PORT=8000
TASK_DURATION=1.0

# Phase 1's stand-in for a worker. Real workers exist now; leave this off.
ENABLE_SIMULATE_ENDPOINT=false

# The test suite uses DATABASE_URL by default. Override it to run the suite
# somewhere else, or serviceless:
#   TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
